# Скопируйте в .env и заполните. Все значения необязательны, кроме TOKEN_ENCRYPTION_KEY.

# Ключ шифрования refresh_token (Fernet). Сгенерировать:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

# База данных. По умолчанию: sqlite:///<абсолютный путь>/backend/data/data.db
# DB_URL=sqlite:///C:/path/to/data.db

# Часовой пояс по умолчанию для новых пользователей
TIMEZONE=Europe/Moscow

# Минимальный интервал между синхронизациями одного пользователя, секунды
SYNC_COOLDOWN=600

# Запускать sync-воркер внутри процесса API (удобно для разработки)
RUN_WORKER_IN_PROCESS=false
WORKER_POLL_INTERVAL=2
NOTIFICATIONS_SYNC_LIMIT=5000

# CORS (через запятую). В dev фронт ходит через vite proxy, CORS не нужен.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Сессии
SESSION_TTL_DAYS=14
COOKIE_SECURE=false

# Шаблон ссылки на пост
ITD_POST_URL_TEMPLATE=https://xn--d1ah4a.com/@{username}/post/{post_id}

LOG_LEVEL=INFO
